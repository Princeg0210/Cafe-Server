# Application Environment
APP_ENV=development
APP_NAME=Jaadoo Udaipur Cafe Management API
SECRET_KEY=change-this-ultra-secret-key-in-production-minimum-32-chars-long

# Database (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cafe_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cafe_db

# Redis Cache & Pub/Sub
REDIS_URL=redis://localhost:6379/0

# Celery Background Workers
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=300
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=300

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# WhatsApp booking notifications (Meta WhatsApp Cloud API) — leave token/ID empty to disable
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_CONFIRMATION_TEMPLATE=booking_confirmation
WHATSAPP_CANCELLATION_TEMPLATE=booking_cancellation

# Supplier bill scanning (Sarvam Document AI Extract, ~INR 1/page) — leave empty to disable
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# Payments — production must use real Razorpay keys; simulated/unsigned payments are refused
# unless APP_ENV=development or ALLOW_TEST_PAYMENTS=true (never enable in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ALLOW_TEST_PAYMENTS=false

# Bank/acquirer settlement webhook: callers must send this value as the X-Webhook-Secret header.
# Leave empty to keep the webhook disabled outside development.
BANK_WEBHOOK_SECRET=

# Android payment-listener phone: set your own values (the repo defaults are refused in production)
ANDROID_DEVICE_TOKEN=
ANDROID_DEVICE_SECRET=

# Booking rules (website, holds, staff-created bookings)
BOOKING_RULES_ENFORCED=true
RESERVATION_CLOSED_WEEKDAYS=1,2
RESERVATION_OPEN_TIME=11:00
RESERVATION_LAST_SLOT_TIME=22:30
